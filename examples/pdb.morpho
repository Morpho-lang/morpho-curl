/** Loads a PDB file from the protein databank and visualizes the atoms */

import curl 
import parser
import color
import kdtree
import graphics, morphoview

/* Very simple PDB parser; not suitable for production purposes. 
   See PDB file format: 
   https://www.cgl.ucsf.edu/chimera/docs/UsersGuide/tutorials/pdbintro.html */

/* CPK-like colors keyed by element letter. */
var atomColors = {
  "C" : Gray(0.5), "N" : Blue, "O" : Red, "H" : White, "S" : Yellow,
  "P" : Orange, "F" : Green, "B" : Pink, "I" : Purple
}

/* Choose a color for an atom based on its element. */
fn atomColor(name) {
  var el = name[0]
  if (el.isnumber() && name.count() > 1) el = name[1]
  if (atomColors.contains(el)) return atomColors[el]
  return Magenta
}

class PDBParser {
  init(str) {
    self.str = str.split("\n")
    self.graphics = nil
  }

  parseAtom(Tokenizer tokenizer) {
    var id = tokenizer.next(),
        name = tokenizer.next(),
        res = tokenizer.next(),
        chain = tokenizer.next(),
        seq = tokenizer.next(),
        p = Matrix([Float(tokenizer.next()),
                    Float(tokenizer.next()),
                    Float(tokenizer.next())])

    self.positions.append(p)

    print "${id} ${name}: ${p[0]} ${p[1]} ${p[2]}"
    self.graphics.display(Sphere(p, 0.5, color=atomColor(name)))
  }

  /* Bonds are pairs within a covalent cutoff, drawn as cylinders. */
  _drawBonds() {
    if (self.positions.count() == 0) return

    var indexOf = Dictionary()
    for (p, i in self.positions) indexOf[p] = i

    var tree = KDTree(self.positions)
    var cutoff = 2
    for (p, i in self.positions) {
      var hits = tree.search([[p[0]-cutoff, p[0]+cutoff],
                              [p[1]-cutoff, p[1]+cutoff],
                              [p[2]-cutoff, p[2]+cutoff]])
      for (node in hits) {
        var q = node.location
        if (indexOf[q] <= i) continue
        if ((p-q).norm() <= cutoff) {
          self.graphics.display(Cylinder(p, q, radius=0.15, color=Gray(0.25)))
        }
      }
    }
  }

  /* Crystal structures omit MODEL/ENDMDL; that file is model 1. */
  _hasModelRecords() {
    for (line in self.str) {
      if (Tokenizer(StringStream(line)).next()=="MODEL") return true
    }
    return false
  }

  _domodel(n, all) {
    self.graphics = Graphics()
    self.positions = []

    var inmodel = all || (n==1 && !self._hasModelRecords())
    for (line in self.str) {
      var tokenizer=Tokenizer(StringStream(line))

      var tok=tokenizer.next()
      if (tok=="MODEL") {
        var m = Int(tokenizer.next())
        if (m==n) inmodel=true
      } else if (tok=="ATOM" &&
                 inmodel) {
        self.parseAtom(tokenizer) 
      } else if (tok=="ENDMDL") {
        inmodel=false
      }
    }

    self._drawBonds()
    return self.graphics
  }

  model(n) { // Extract model n
    return self._domodel(n, false)
  }

  model() { // Extract all atoms
    return self._domodel(0, true) 
  }
}

//var url = "https://files.rcsb.org/download/6NXL.pdb" // Ubiquitin 
var url = "https://files.rcsb.org/download/2MVH.pdb" // A small protein 

var protein = Curl(url).fetch() 

var prs = PDBParser(protein)
Show(prs.model(1)) // A PDB file may contain many models 
